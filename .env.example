# ═══════════════════════════════════════════════════════════════════════════════
# TANKO - Variables de Entorno
# ═══════════════════════════════════════════════════════════════════════════════
# COPIA este archivo como .env en la raíz del proyecto y configura los valores.
# ═══════════════════════════════════════════════════════════════════════════════

# ── APLICACIÓN ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── STELLAR NETWORK ──────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ── SOROBAN SMART CONTRACT (Tank Registry) ──────────────────────────────────
# ID del contrato desplegado en Soroban testnet (TankoRegistry)
SOROBAN_CONTRACT_ID=CARYBGHV22I5GQBC3DE2EDUVNQWRJTW65BUSD2HF7N23WWMMYEFE52I7
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── TRUSTLESS WORK API ───────────────────────────────────────────────────────
# URL base de la API de Trustless Work
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
NEXT_PUBLIC_TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com

# API Key de Trustless Work (obtenla en https://app.trustlesswork.com)
TRUSTLESS_WORK_API_KEY=

# ID del Escrow principal (Multi-Release)
ESCROW_ID=

# ── FUEL PRICE ORACLE ────────────────────────────────────────────────────────
# Seed prices (MXN per liter) used until the worker updates from regulatory sources
ORACLE_SEED_PRICE_MAGNA=24.00
ORACLE_SEED_PRICE_PREMIUM=28.66
ORACLE_SEED_PRICE_DIESEL=27.44

# Oracle signing key (Ed25519 / Stellar-compatible). Generate with: stellar keys generate
ORACLE_PRIVATE_KEY=
ORACLE_PUBLIC_KEY=

# Soroban FuelPriceOracle contract ID (after deploy)
ORACLE_CONTRACT_ID=

# Regulatory price source (optional JSON API)
ORACLE_PRICE_SOURCE_URL=
ORACLE_DEFAULT_STATION_ID=CRE-MX-001

# Scheduled worker: fetches prices without blocking API requests
ORACLE_WORKER_ENABLED=true
ORACLE_WORKER_INTERVAL_MS=3600000

# ── FX (MXN → USDC) ──────────────────────────────────────────────────────────
# Fallback MXN per 1 USD (24 MXN / 17.24 ≈ 1.39 USDC)
FX_MXN_PER_USD=17.24
FX_RATE_API_URL=

# ── ADMIN WALLET ─────────────────────────────────────────────────────────────
# Secret key del administrador (SOLO PARA BACKEND - NUNCA EXPONER)
TANKO_ADMIN_SECRET=

# ── BASE DE DATOS ─────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tanko_db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ── FRONTEND ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3001

# Stellar public key of the fleet manager (jefe) for fund requests
NEXT_PUBLIC_MANAGER_PUBKEY=

# WalletConnect / Decaf Wallet (obtenlo en https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# NextAuth
NEXTAUTH_SECRET=change_this_to_a_random_string_32_chars
NEXTAUTH_URL=http://localhost:3000

# ── EMAIL (Transactional Notifications) ──────────────────────────────────────
# SMTP credentials (works with Resend, SendGrid, Gmail, Mailtrap, etc.)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Tanko <noreply@tanko.app>"
